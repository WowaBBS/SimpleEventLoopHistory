<?
include 'All.Test.php';

// Подписываемся на сигнал SIGINT (Константа 2 - это универсальный SIGINT)
Loop::addSignal(2, function() {
  echo "\n[Signal] Received Ctrl+C! Softly finish jobs...\n";
  Loop::stop();
});

Loop::async(function() {
  echo "[Process] Start parallel requests...\n";

  // Создаем массив асинхронных задач
  $promise_stop=sleepAsync(5)->then(function() { Loop::stop(); return "Sleeping_Stop is done"; });
  $promises = [
    'request_1' => httpGetAsync('http://127.0.0.1'), // ответит через 1 сек
    'request_2' => httpGetAsync('http://127.0.0.1/Unknown'), // ответит через 2 сек
    'manual_sleep_1' => sleepAsync(1.5)->then(fn() => "Sleeping_1 is done"),
    'manual_sleep_2' => sleepAsync(1  )->then(fn() => "Sleeping_2 is done"),
  //'manual_sleep_stop' => $promise_stop,
  ];

  try
  {
    // Одновременное ожидание всех задач через Fiber await!
    // Общее время выполнения будет ~2 секунды вместо 4.5 последовательных.
    $results = Promise::all($promises)->await();

    echo "[Process] All tasks have done!\n";
    echo "The result of sleeping1: " . $results['manual_sleep_1'] . "\n";
    echo "The result of sleeping2: " . $results['manual_sleep_2'] . "\n";
    echo "Length of response1 is: " . strlen($results['request_1']?? '') . " bytes\n";
    echo "Length of response2 is: " . strlen($results['request_2']?? '') . " bytes\n";
  }
  catch (\Throwable $e)
  {
    echo "[Process] Error was happend in one of the task: " . $e->getMessage() . "\n";
  }
});

echo "--- Start Event Loop (press Ctrl+C for checking of signals) ---\n";
Loop::run();
echo "--- Event loop has done without of errors ---\n";
