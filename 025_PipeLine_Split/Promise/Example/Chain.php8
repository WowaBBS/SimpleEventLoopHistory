<?
include '../../_All.Test.php';

//Чейнинг (Цепочки вызовов)
$deferred = new Deferred();
$promise=$deferred->promise();
$promise
  ->then(fn($dbResult) => $dbResult['Data'])
  ->then(fn($json) => $json['userId'])
  ->then(fn($id) => Logger::log('User ID: ', $id)->Ret());

$deferred->resolve(['Data'=>['userId'=>'Wowa']]);
