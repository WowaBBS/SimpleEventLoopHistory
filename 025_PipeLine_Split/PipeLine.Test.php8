<?
include 'All.Test.php';
include 'PipeLine.Test.php';

Loop::setTimeLimit(15, 5);

Loop::async(function() use ($db) {
  $task = 'MyTask';

  Logger::log("--- START TEST ---");
  
  // Создаем стартовый пайплайн
  $totalAmount = Pipeline::from($db->queryAsyncStream("SELECT * FROM TableA WHERE task = ?", [$task]))
    // Разветвление потока на несколько независимых детей
    ->fork(function(Pipeline $pipeline) {
      // Ветка 1: Просто пишем в лог параллельно
      $pipeline->map(fn($row) => Logger::log('Get TableA.Item.Name: ' . $row['name'])->Ret())->run();
    })
    
    // Основная ветка конвейера
    ->map(function($row) {
      return [$row, httpGetAsync($row['url'])];
    })
    // Выделенный оператор для ожидания параллельных HTTP-промисов из массива
    ->resolvePromises()

    // Группировка
    ->group(count: 100, timeout: 1.0)

    ->map(function($list) use ($db) {
      Logger::log(">>> The group has been formed! Responses received: " . count($list));
      $ids = [];
      foreach ($list as $item)
      {
        $response = $item[1];
        if ($response instanceof \Throwable || !$response->isSucessfull())
        {
          Logger::log('Wrong answer');
          continue;
        }
        
        $data = json_decode($response->getContent());
        $ids[] = $data->id;
      }
      // Возвращаем промис запроса к БД
      return $db->queryAsync('SELECT * FROM TableB WHERE id in (' . implode(',', $ids) . ')');
    })
    // Разворачиваем полученный из БД массив строк TableB, чтобы sum() считал их поштучно
    ->unpack()
    
    // Суммируем строго по контракту атомарных айтемов
    ->sum(fn($rowB) => $rowB['amount'])

    // Запускаем сбор
    ->collect()
    ->await();

  // Запись финала
  $db->queryAsync('INSERT INTO TableC (task, totalAmount, time) VALUES(?, ?, NOW())', [$task, $totalAmount])->await();
  Logger::log("Recording the final result in TableC. Final total: " , $totalAmount);

  Logger::log("--- END OF TEST ---");
});

// Запускаем Цикл Событий
Loop::run();
