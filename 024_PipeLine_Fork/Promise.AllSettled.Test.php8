<?
include 'All.Test.php';

Loop::async(function() {
  echo "[Process] We are launching a survey of independent services....\n";

  $promises = [
    'service_card'   => sleepAsync(0.5)->then(fn() => 15000), // Успешно вернет баланс
    'service_crypto' => sleepAsync(1.0)->then(fn() => throw new \RuntimeException("Service crypts are unavailable.")), // Упадет
    'service_qiwi'   => sleepAsync(1.5)->then(fn() => 450)   // Успешно вернет баланс
  ];

  // Метод allSettled() никогда не выбросит исключение в await!
  $report = Promise::allSettled($promises)->await();

  echo "[Process] All services have been polled. Generating report:\n\n";

  foreach ($report as $serviceName => $result)
  {
    if ($result['status'] === 'fulfilled')
      echo "? Balance in {$serviceName}: $" . $result['value'] . ".\n";
    else // В поле 'reason' лежит Throwable или строка ошибки
      echo "? Error in {$serviceName}: " . $result['reason']->getMessage() . "\n";
  }
});

// Запускаем Event Loop
Loop::run();