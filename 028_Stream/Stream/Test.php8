<?
include '../_All.Cli.php';

Loop::async
(function(){
  $stream = new Stream_Async_Mock()->syncStream();

  Loop::async(function() use($stream){
    $example = <<<HereDoc
      Hello world!
      next
      next2
      next3
      
      
      HereDoc;
    $stream->write($example);
    //sleepAsync(1)->await();
    $stream->write('Delayed'."\n");
    $stream->writeEnd();
  });
  $tests = [
    [0, 'Hello'   ,fn()=>$stream->read    (5            )],
    [1, ' world!' ,fn()=>$stream->readLine(             )],
    [2, "next\n"  ,fn()=>$stream->until()->str("\n")->include(true )->read()],
    [3, 'next2'   ,fn()=>$stream->until()->str("\n")->include(false)->read()],
    [4, ''        ,fn()=>$stream->until()->str("\n")->include(false)->read()],
    [5, ''        ,fn()=>$stream->readLine(             )],
    [6, 'next3'   ,fn()=>$stream->readLine(             )],
    [7, ''        ,fn()=>$stream->readLine(             )],
    [8, 'Delayed' ,fn()=>$stream->readLine(             )],
  ];
  
  try
  {
    foreach($tests as [$k, $desired, $func])
    {
      $actual = $func();
      
      if ($actual !== $desired)
      {
        Logger::error('Failed: ',$k)(['desired'=>$desired])(['actual'=>$actual]);
        break;
      }
      else
        Logger::log($k, ' Ok');
    }
  }
  catch(\Throwable $e)
  {
    Logger::exception($e, 'StreamTest:');
  //TODO: $stream->abort();
  }
  
//})();
});
