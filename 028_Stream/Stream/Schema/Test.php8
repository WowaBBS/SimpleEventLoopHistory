<?php
include '../../_All.Cli.php';

use Stream_Schema_Factory as Factory;

Loop::async(function() {
  Logger::logAsync('[Test] Initializing a binary Loopback test...');

  // 1. Создаем асинхронный loopback и оборачиваем его в наш синхронный стрим
  $asyncLoopback = new Stream_Async_LoopBack();
  $stream = $asyncLoopback->syncStream();

  // --- ЕДИНАЯ ДЕКЛАРАТИВНАЯ КАРТА ПРОТОКОЛА ---
  $packetSchema = Factory::get([
    'magic_marker' => 'uint8',
    'status_code'  => 'int16be', // Проверим отрицательное число в Big-Endian
    'velocity'     => 'int32le', // Проверим отрицательное число в Little-Endian

    // Паттерн 1 (Префиксный тип): Говорим, что это строка, 
    // длина которой запишется/прочитается как 32-битный Big-Endian инт
  //'payload'      => 'p:u32b', 
    'payload'      => Factory::prefixed('uint32be'),
    
    'vectors'      => Factory::struct([
      'alpha' => 'float32le',
      'beta'  => 'float64be',
    ]),
    
    // Паттерн 3 (Если нужно кастомное хитрое поле, пример кодек-пары)
    'checksum' => new Stream_Schema_Custom(
      fn($s) => $s->readData(2),
      fn($s, $val) => $stream->writeData(str_pad((string)$val, 2, "0"))
    ),
  ]);


  // Данные для отправки
  $originalData = [
    'magic_marker' => 0xAF,
    'status_code'  => -500,  // Отрицательное 16-бит
    'velocity'     => -100500, // Отрицательное 32-бит
    'payload'      => 'Hello from the asynchronous binary codec!',
    'vectors'      => [
      'alpha' => 3.14159,
      'beta'  => 2.718281828459
    ],
    'checksum' => 'XY',
  ];

  Logger::logAsync('[Test] Packing and writing a structure to a loopback stream...');

  // Записываем структуру одной командой
  $bytesWritten = $stream->schema($packetSchema)->write($originalData);
  $bytesWritten = $stream->schema($packetSchema)->write($originalData);
  Logger::logAsync("[Test] Successfully wrote $bytesWritten bytes.");

  Logger::logAsync('[Test] Reading and deserializing a structure from a stream...');

  // Читаем структуру из этого же стрима
  $parsedData = $stream->read($packetSchema); // The same
  $parsedData = $stream->schema($packetSchema)->read();

  Logger::logAsync('[Test] Verification of the obtained results:');

  // Проверяем корректность восстановления данных
  assert($parsedData['magic_marker'] === $originalData['magic_marker'], 'Failure magic_marker');
  Logger::log('  - Magic Marker: OK (0x' , dechex($parsedData['magic_marker']) , ')');

  Assert::equals($originalData['status_code'], $parsedData['status_code'], 'Failure status_code');
  Logger::log('  - Status Code (i16be): OK (' , $parsedData['status_code'] , ')');

  assert($parsedData['velocity'] === $originalData['velocity'], 'Failure velocity');
  Logger::log('  - Velocity (i32le): OK (' , $parsedData['velocity'] , ')');

  assert($parsedData['payload'] === $originalData['payload'], 'Failure payload');
  Logger::log('  - Payload String: OK (\'' , $parsedData['payload'] , '\')');

  // Сверка float с допустимой дельтой погрешности
  assert(abs($parsedData['vectors']['alpha'] - $originalData['vectors']['alpha']) < 0.0001, 'Failure alpha float');
  Logger::log('  - Vector Alpha (f32l): OK (' , $parsedData['vectors']['alpha'] , ')');

  assert(abs($parsedData['vectors']['beta'] - $originalData['vectors']['beta']) < 0.000000001, 'Failure beta double');
  Logger::log('  - Vector Beta (f64b): OK (' , $parsedData['vectors']['beta'] , ')');

  Logger::log('[Test] ALL CHECKS PASSED SUCCESSFULLY! The codec works perfectly,');

  $stream->close();
});
