<?
use Stream_Schema_Factory as Factory;

include '../../../_All.Cli.php';
Loop::async(function() {
  $tests = [
    // ===== 8 бит =====
    ['uint8' ,['00' => 0, '01' => 1, '7F' => 127, '80' =>  128, 'FF' => 255 ], 'uint8' ,0x100],
    ['int8'  ,['00' => 0, '01' => 1, '7F' => 127, '80' => -128, 'FF' => -1  ], 'int8'  ,-1],
  
    // ===== 16 бит =====
    ['uint16be', [
      '0000' => 0, '0001' => 1, '0080' => 128, '0100' => 256, 
      '1234' => 0x1234, '7FFF' => 32767, '8000' => 32768, 'FFFF' => 65535
    ],'uint16le', 0x10000],
  
    // ===== 24 бита, беззнаковое, big-endian =====
    ['uint24be', [
      '000000' => 0,
      '000001' => 1,
      '000080' => 0x000080,
      '000100' => 0x000100,
      '010000' => 0x010000,
      '123456' => 0x123456,
      '7FFFFF' => 0x7FFFFF, // половина диапазона минус 1
      '800000' => 0x800000, // граница <знакового> бита - для uint всё ещё положительное
      'FFFFFF' => 0xFFFFFF, // максимум (2^24 - 1)
    ],'uint24le', 0x1000000],
    
    // ===== 32 бита =====
    ['uint32be', [
      '00000000' => 0, '00000001' => 1, '00000080' => 128, '00000100' => 256, 
      '01000000' => 16777216, '12345678' => 0x12345678, 
      '7FFFFFFF' => 2147483647, '80000000' => 2147483648, 
      'FFFFFFFF' => 4294967295
    ], 'uint32le', 0x100000000],
  
    // ===== 48 бит, беззнаковое, big-endian =====
    ['uint48be', [
      '000000000000' =>               0,
      '000000000001' =>               1,
      '000000010000' =>           65536,
      '000001000000' =>        16777216,
      '010000000000' =>   1099511627776, // 2^40
      '1234567890AB' =>  20015998341291, // 0x1234567890AB
      '7FFFFFFFFFFF' => 140737488355327, // половина диапазона минус 1
      '800000000000' => 140737488355328, // 2^47
      'FFFFFFFFFFFF' => 281474976710655, // максимум (2^48 - 1)
    ],'uint48le', 0x1000000000000],
  
    // ===== 64 бита =====
    ['int64be', [
      '0000000000000000' => 0, 
      '0000000000000001' => 1,
      '00000000000000FF' => 255,
      '0100000000000000' => 0x0100000000000000,
      '0123456789ABCDEF' => 0x0123456789ABCDEF,
      '00FFFFFFFFFFFFFF' => 0x00FFFFFFFFFFFFFF,
      '7FFFFFFFFFFFFFFF' => 0x7FFFFFFFFFFFFFFF,
      'FFFFFFFFFFFFFFFE' => -2,
      'FFFFFFFFFFFFFFFF' => -1,
      '8000000000000000' => ~0x7FFFFFFFFFFFFFFF,
    ], 'int64le', -1],
    
    // ===== float32 (IEEE 754 single) =====
    ['float32be', [
      '00000000' =>  0.0,
      '80000000' => -0.0,
      '3F800000' =>  1.0,
      'BF800000' => -1.0,
      '40000000' =>  2.0,
      'C0000000' => -2.0,
      '3E800000' =>  0.25,
      '4048F5C3' => 3.140000104904175,      // это float32(3.14)
      '42F6E979' => 123.45600128173828,
      '3DCCCCCD' => 0.10000000149011612,    // это float32(0.1)
      '7F7FFFFF' => 3.4028234663852886e+38, // макс. конечное
      '00800000' => 1.1754943508222875e-38, // мин. нормальное
      '00000001' => 1.401298464324817e-45,  // мин. денормализованное
      '7F800000' =>  INF,
      'FF800000' => -INF,
      '7FC00000' =>  NAN,
    ], 'float32le', -1],
  
    // ===== float64 (IEEE 754 double) =====
    ['float64be', [
      '0000000000000000' => 0.0,
      '8000000000000000' => -0.0,
      '3FF0000000000000' => 1.0,
      'BFF0000000000000' => -1.0,
      '4000000000000000' => 2.0,
      'C000000000000000' => -2.0,
      '3FE0000000000000' => 0.5,
      '3FB999999999999A' => 0.1,
      'BFB999999999999A' => -0.1,
      '3FD5555555555555' => 0.3333333333333333, // 1/3
      '400921FB54442D18' => M_PI,
      '4059000000000000' => 100.0,
      'C059000000000000' => -100.0,
      '405EDD2F1A9FBE77' => 123.456,
      '4340000000000000' => 4503599627370496.0, // 2^52 - предел точности int в double
      '7FEFFFFFFFFFFFFF' => 1.7976931348623157e+308, // DBL_MAX
      '0000000000000001' => 5.0e-324,           // мин. денормализованное
      '7FF0000000000000' => INF,
      'FFF0000000000000' => -INF,
      '7FF8000000000000' => NAN,
    ],'float64le', -1],
    // ===== UTF-8 multibyte: hex => code point =====
    ['intUtf8', [
      // 1 байт: U+0000..U+007F
      '00'       => 0,            // минимум
      '01'       => 1,
      '41'       => 0x41,         // 65, 'A'
      '7F'       => 127,          // граница однобайтовых
  
      // 2 байта: U+0080..U+07FF
      'C280'     => 128,          // 0x80, первый многобайтовый
      'C2A0'     => 160,          // 0xA0
      'C380'     => 192,          // 0xC0
      'DFBF'     => 2047,         // 0x7FF, максимум 2 байт
  
      // 3 байта: U+0800..U+FFFF
      'E0A080'   => 2048,         // 0x800, первый трёхбайтовый
      'E18080'   => 4096,         // 0x1000
      'E282AC'   => 8364,         // 0x20AC, символ '?' - классика
      'EFBFBD'   => 65533,        // 0xFFFD, replacement char
      'EFBFBF'   => 65535,        // 0xFFFF, максимум 3 байт
  
      // 4 байта: U+10000..U+10FFFF
      'F0908080' => 65536,        // 0x10000, первый четырёхбайтовый
      'F09FA680' => 129408,       // 0x1F980, <краб> - пример за BMP
      'F48FBFBF' => 1114111,      // 0x10FFFF, максимум Unicode
  
      // === невалидные входы: декодер должен вернуть ошибку ===
      'C080'     => null,         // overlong-кодирование U+0000
      'C1BF'     => null,         // overlong (всё в C0/C1 запрещено)
      'E08080'   => null,         // overlong U+0000 в 3 байтах
      'F0808080' => null,         // overlong U+0000 в 4 байтах
      'EDA080'   => null,         // U+D800 - суррогаты запрещены
      'EDBFBF'   => null,         // U+DFFF - суррогаты запрещены
      'F4908080' => null,         // 0x110000 - за пределом Unicode
      'F8888888' => null,         // байты старше F4
      '80'       => null,         // одиночный continuation-байт
      'C2'       => null,         // обрезанная последовательность
      'E282'     => null,         // обрезанная последовательность
      'C328'     => null,         // 0x28 - не continuation-байт
    ], null, -1],
    
    // ===== UTF-8 extended (суррогаты разрешены, до 6 байт, до 0x7FFFFFFF) =====
    ['intWtf8', [
      // 1 байт: 0x00..0x7F
      '00'   => 0,
      '41'   => 65,          // 'A'
      '7F'   => 127,
    
      // 2 байта: 0x80..0x7FF
      'C280' => 128,
      'DFBF' => 2047,
    
      // 3 байта: 0x800..0xFFFF - включая суррогаты
      'E0A080' => 2048,
      'E282AC' => 8364,      // 0x20AC, '?'
      'ED9FBF' => 55295,     // 0xD7FF - последнее перед суррогатами
      'ED8080' => 55296,     // 0xD800 - суррогат, теперь ВАЛИДЕН
      'EDBFBF' => 57343,     // 0xDFFF - суррогат, теперь ВАЛИДЕН
      'EE8080' => 57344,     // 0xE000 - первое после суррогатов
      'EFBFBF' => 65535,
    
      // 4 байта: 0x10000..0x1FFFFF - включая то, что раньше было запрещено
      'F0908080' => 65536,        // 0x10000
      'F48FBFBF' => 1114111,      // 0x10FFFF - больше не предел, просто число
      'F4908080' => 1114112,      // 0x110000 - теперь ВАЛИДНО (в intUtf8 было null)
      'F48F9080' => 1114113,      // 0x110001
      'F7BFBFBF' => 2097151,      // 0x1FFFFF - максимум 4 байт
    
      // 5 байт: 0x200000..0x3FFFFFF
      'F8A0808080' => 2097152,    // 0x200000 - первая 5-байтовая
      'F980808080' => 16777216,   // 0x1000000 - круглая степень двойки
      'FB8FBFBFBF' => 67108863,   // 0x3FFFFFF - максимум 5 байт
    
      // 6 байт: 0x4000000..0x7FFFFFFF
      'FC8880808080' => 67108864,    // 0x4000000 - первая 6-байтовая
      'FDBFBFBFBFBF' => 2147483647,  // 0x7FFFFFFF - абсолютный максимум (31 бит)
    
      // === невалидные входы ===
      // Overlong-кодирования - по-прежнему запрещены на ВСЕХ длинах
      'C080'         => null,   // overlong U+0000 в 2 байтах
      'E08080'       => null,   // overlong U+0000 в 3 байтах
      'F0808080'     => null,   // overlong U+0000 в 4 байтах
      'F888808080'   => null,   // overlong в 5 байтах (значение 0)
      'FC8080808080' => null,   // overlong в 6 байтах (значение 0)
      // Обрезанные последовательности
      'C2'           => null,
      'E282'         => null,
      'F09080'       => null,
      'F8A08080'     => null,
      'FC88808080'   => null,
      // Не continuation-байт в середине
      'C328'         => null,
      'E2827F'       => null,
      'F0903F80'     => null,
      // Байты-нарушители: ведущий после FD и одиночные
      '80'           => null,   // одиночный continuation-байт
      'FE'           => null,
      'FF'           => null,
      'FE8080808080' => null,   // 7 <байт> - схема максимум 6
      'FEBFBFBFBFBF' => null,   // то же, полноценная форма
    ], null, -1],
    // ===== UTF-16BE: 2 байта для 0x0000..0xFFFF (без суррогатов), 4 байта для 0x10000..0x10FFFF =====
    ['intUtf16be', [
      // === 2 байта ===
      '0000' => 0,           // минимум
      '0041' => 65,          // 'A'
      '007F' => 127,
      '0080' => 128,
      '00FF' => 255,
      '0100' => 256,
      '07FF' => 2047,
      '0800' => 2048,
      '20AC' => 8364,        // 0x20AC, '?'
      '1234' => 0x1234,      // 4660 - наглядно про порядок байтов
      'D7FF' => 55295,       // последнее перед суррогатами
  
      // === 4 байта (суррогатные пары) ===
      'D800DC00' => 65536,        // 0x10000 - первая пара
      'D800DC01' => 65537,        // 0x10001
      'D800DFFF' => 66303,        // 0x103FF - границы lo-компоненты (DC00 и DFFF)
      'DBFFDC00' => 1114112 - 1024,  // 0x10FC00 - границы hi-компоненты
      'D801DC37' => 66551,        // 0x10437 - классический пример из стандарта (??)
      'D83EDD80' => 129408,       // 0x1F980 - <краб> ??
      'DBFFDFFF' => 1114111,      // 0x10FFFF - абсолютный максимум
  
      // === невалидные входы ===
      // Одиночные суррогаты
      'D800'         => null,   // одиночный high surrogate
      'DBFF'         => null,   // то же, крайний
      'DFFF'         => null,   // одиночный low surrogate
      'DC00'         => null,   // то же, крайний
      // Нарушенная пара
      'D8000041'     => null,   // high + обычный символ вместо low
      'D800D800'     => null,   // high + high
      'D800DBFF'     => null,   // high + high (крайний случай)
      'DBFFC000'     => null,   // low вне диапазона DC00..DFFF
      'DBFFE000'     => null,   // low = 0xE000, <после суррогатов> - невалидно
      'DC00D800'     => null,   // порядок перевёрнут: low + high
      'DC00DC00'     => null,   // low + low
      '00410041'     => null,   // 4 байта без суррогатов - пары не образуют
      // Обрывы и мусор
      'D8'           => null,   // нечётная длина
      'D800DC'       => null,   // обрезанная пара
      ''             => null,   // пустой вход
    ], 'intUtf16le', 2],
    // ===== varint: 7 бит на байт, старший бит = <есть продолжение> (младшая группа первой, как в Protobuf/LEB128) =====
    ['varint', [
      // 1 байт: 0..127
      '00' => 0,
      '01' => 1,
      '41' => 65,          // 'A' - однобайтовые совпадают с самим числом
      '7F' => 127,         // максимум 1 байта
  
      // 2 байта: 128..16383
      '8001' => 128,       // первая двубайтовая
      'FF01' => 255,
      '8002' => 256,
      'AC02' => 300,       // не gradoвой случай, для разнообразия бит
      'FF7F' => 16383,     // максимум 2 байт
  
      // 3 байта: 16384..2097151
      '808001' => 16384,   // первая трёхбайтовая
      'FFFF03' => 65535,
      '808004' => 65536,   // 2^16
      'D6E848' => 1193046, // 0x123456
      'FFFF7F' => 2097151, // максимум 3 байт (2^21-1)
  
      // 4 байта: 2097152..268435455
      '80808001' => 2097152,
      '80808004' => 8388608,   // 2^23
  
      // 5 байт и дальше - степень двойки как маркеры границ
      '8080808001' => 268435456,      // 2^28 - первая 5-байтовая
      '8080808008' => 2147483648,     // 2^31
      'FFFFFFFF0F' => 4294967295,     // максимум uint32 (2^32-1)
      '808080808001' => 34359738368,  // 2^35 - первая 6-байтовая
  
      // 10 байт: вся 64-битная шкала
      '80808080808080808001'   => 9223372036854775808,      // 2^63 - уже за пределами положительного int в PHP!
      'FFFFFFFFFFFFFFFF7F'     => 9223372036854775807,      // PHP_INT_MAX, 9 байт
      'FFFFFFFFFFFFFFFFFF01'   => '18446744073709551615',   // 2^64-1 - только как строка или через GMP
  
      // === невалидные входы ===
      '80'     => null,  // обрыв: последний байт несёт флаг продолжения
      '8080'   => null,  // то же, два байта
      'FF'     => null,  // обрыв
      'FFFFFFFF' => null, // обрыв на 32 битах
      // не-минимальные (избыточные) кодирования - см. примечание ниже
      '8000'   => null,  // 0, закодированный двумя байтами
      '8100'   => null,  // 1, закодированный двумя байтами
      '808001' => 16384, // а это минимальный - для контраста
    ], null, -1],
    // ===== sintZigZag: число n кодируется varint от zigzag(n) = (n << 1) ^ (n >> 63) =====
    // Знаковый бит <переехал> в младший бит: 00, -11, 12, -23, 24...
    ['ZigZag', [
      // малые значения - главный смысл ZigZag: минус один байт
      '00' => 0,
      '01' => -1,
      '02' => 1,
      '03' => -2,
      '04' => 2,
      '05' => -3,
      '7E' => 63,
      '7F' => -64,        // максимум 1 байта: zigzag = 127
      '8001' => 64,       // граница: zigzag = 128
      '8101' => -65,
      'C801' => 100,
      'C701' => -100,
      'D804' => 300,
      'D704' => -300,
      'FF7F' => -8192,    // zigzag = 16383, максимум 2 байт
      '808001' => 8192,   // zigzag = 16384
      'FEFF07' => 65535,
      'FFFF07' => -65536,
  
      // 32-битные границы (тот же zigzag для sint32 и sint64)
      'FEFFFFFF0F' => 2147483647,    // INT32_MAX: zigzag = 2^32-2
      'FFFFFFFF0F' => -2147483648,   // INT32_MIN: zigzag = 2^32-1
      'FDFFFFFF0F' => -2147483647,
      '8080808010' => 2147483648,    // 2^31: zigzag = 2^32
      '8080808020' => 4294967296,    // 2^32: zigzag = 2^33
      'FFFFFFFF1F' => -4294967296,   // -2^32: zigzag = 2^33-1
  
      // 64-битная шкала
      '80808080808080808001' => 4611686018427387904,       // 2^62: zigzag = 2^63 (за пределами int!)
      'FFFFFFFFFFFFFFFF7F'   => -4611686018427387904,      // -2^62: zigzag = 2^63-1, ещё int
      'FEFFFFFFFFFFFFFF7F'   => 4611686018427387903,       // 2^62-1: zigzag = 2^63-2
      'FEFFFFFFFFFFFFFFFF01' => 9223372036854775807,       // PHP_INT_MAX: zigzag = 2^64-2
      'FFFFFFFFFFFFFFFFFF01' => '-9223372036854775808',    // INT64_MIN: zigzag = 2^64-1 (строка!)
  
      // === невалидные входы ===
      '80'     => null,  // обрыв: флаг продолжения в последнем байте
      '8080'   => null,
      '8000'   => null,  // не-минимальное кодирование: zigzag 0 двумя байтами
      '8100'   => null,  // то же для zigzag 1 (n = -1)
    ], null, -1],    
    //Signed varint / ZigZag
    // ===== sleb128: те же 7-битные группы LSB-first, но последний байт знакорасширяется =====
    // Минимальное кодирование: последний байт обязан иметь бит 6, равный знаку числа.
    ['sleb128', [
      // 1 байт (диапазон -64..63)
      '00' => 0,
      '01' => 1,
      '3F' => 63,        // 0b0111111 - максимум положительного в 1 байте
      '41' => -63,       // 0b1000001
      '40' => -64,       // 0b1000000 - минимум в 1 байте
      '7F' => -1,        // знакорасширение 0b1111111
  
      // 2 байта (диапазон -8192..8191)
      'C000' => 64,      // граница: 64 уже не влезает в 1 байт (бит 6 = 0 требовал бы знак +)
      'FF00' => 127,     // ловушка: 127 НЕ кодируется как '7F' - тот байт означал бы -1
      '8001' => 128,
      'AC02' => 300,
      'D47D' => -300,
      'BF7F' => -65,
      '8040' => -8192,   // минимум 2 байт: 0x40 = 0b1000000, знакорасширение  -64 << 7
      'FF3F' => 8191,    // максимум 2 байт
  
      // 3+ байт
      'FFFF03' => 65535,
      '80807C' => -65536,      // -4 << 14
      'FFBF7F' => -8193,
      'FFFFFFFF07' => 2147483647,
      '8080808078' => -2147483648,  // -8 << 28
      'FFFFFFFF0F' => 4294967295,
      '8080808070' => -4294967296,  // -16 << 28
      '808080808001' => 34359738368,    // 2^35
      '80808080807F' => -34359738368,   // -2^35
  
      // 10 байт - вся 64-битная шкала
      'FFFFFFFFFFFFFFFFFF00' => 9223372036854775807,       // INT64_MAX: 9?'FF' + '00'
      '8080808080808080807F' => -9223372036854775808,      // INT64_MIN: 9?'80' + '7F'
      '8180808080808080807F' => -9223372036854775807,      // INT64_MIN + 1
  
      // === невалидные входы ===
      '80'         => null,  // обрыв
      'C0'         => null,  // обрыв с <незавершённым> знаком
      // Не-минимальные кодирования - формально декодируются, канонически запрещены
      '8000'       => null,  // 0 двумя байтами
      '8100'       => null,  // 1 двумя байтами
      'FF7F'       => null,  // -1 двумя байтами ('7F' - минимальная форма)
      'FFFF00'     => null,  // 127 тремя байтами
      '80807F'     => null,  // -8192 тремя байтами - знак уже определён во втором байте
    ], null, -1],
    //Signed LEB128
  ];
  
  foreach ($tests as $k1=>[$type, $list, $invType, $limit])
  {
    foreach ($list as $khex=>$value)
    {
      $subs = [];
      $hex=$khex;
      $bin = hex2bin($hex);
      $subs[] = [$type, $hex, $bin, $value];
      if ($limit > 0 && $type[0] === 'u')
        $subs[] = [substr($type, 1), $hex, $bin, $value >= $limit>>1? $value - $limit:$value];
      
      if ($invType !== null)
      {      
        $bin = strrev($bin);
        $hex = bin2hex($bin);
        $subs[] = [$invType, $hex, $bin, $value];
        if ($limit > 0 && $invType[0] === 'u')
          $subs[] = [substr($invType, 1), $hex, $bin, $value >= $limit>>1? $value - $limit:$value];
      }
      
      foreach ($subs as $k2=>[$subType, $hex, $bin, $desired])
        try
        {
          $asyncLoopback = new Stream_Async_LoopBack();
    
          $stream = $asyncLoopback->syncStream();
          
          $stream->write($bin);
          $stream->writeEnd();
          $actual = $stream->schema(Factory::get($subType))->read();
          
          if (Assert::equals($desired, $actual, ['Failure ', $subType, ', Value=', $desired, ', hex=', $hex, ', Limit=', $limit>>1, 'k'=>[$k1, $khex, $k2]]))
            Logger::log($subType, ' ', $hex, ' Ok',['k'=>[$k1, $khex, $k2]]);
          else
          { //try again for debug
            Logger::error($subType, ' ', $hex, ' Error');
            $asyncLoopback = new Stream_Async_LoopBack();
  
            $stream = $asyncLoopback->syncStream();
            
            $stream->write($bin);
            $stream->writeEnd();
            $actual = $stream->schema(Factory::get($subType))->read();
          }
        }
        catch(\Throwable $e)
        {
          Logger::error($subType, ' ', $hex, ' Exception')->exception($e);
        }
    }
  }
});