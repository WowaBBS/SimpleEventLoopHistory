<?
include '../_All.Cli.php';

class Header //implements IStream_Struct
{
  var $key   ;
  var $value ;
  
  function __construct(string $line='')
  {
    $line = explode(':', $line, 2);
    $this->key   = trim($line[0]);
    $this->value = trim($line[1]);
  }
  
  function __tostring() { return $this->key.': '.$this->value."\r\n"; }
}

//Header1
//...
//HeaderN
//EmptyHeader
class Headers //implements IStream_Struct
{
  var $first ; //First line
  var $list  =[]; //Header[]
  
  function read(IStream $s)
  {
    $this->first = $s->readLine("\r\n", strict: true);
    while (strlen($line = $s->readLine("\r\n", strict: true)))
      $this->list[] = new Header($line);
  }

  function write(IStream $s)
  {
  /*$s->write(
      $this->first ,"\r\n" ,
      $this->list  ,"\r\n" ,
    );*/
    $s->write($this->first, "\r\n");
    foreach ($this->list as $item)
      $s->write($item);
    $s->write("\r\n");
  }
}

// NumLines
// Line1
// ...
// LineN
class Chunk //implements IStream_Struct
{
  var $list = [];
  
  function __construct($list) { $this->list = $list; }

  static function read(IStream $s)
  {
    $count = (int)$s->readLine("\r\n", strict: true);
    if (!$count) return null;
    
    $list = [];
    for (; $count>0; $count--)
      $list[] = $s->readLine("\r\n", strict: true);
    
    return new Chunk($list);
  }

  function write(IStream $s)
  {
    $s->write((string)count($this->list), "\r\n");
    foreach ($this->list as $item)
      $s->write($item, "\r\n");
  }
}

class Request //implements IStream_Struct
{
  var $headers ;
  var $chunks  =[];
  
  function __construct()
  {
    $this->headers = new Headers ();
  }

  function read(IStream $s)
  {
  /*$s->read(
      $this->headers,
      $this->chunks
    );*/
             
    $this->headers ->read($s);
    
    while ($chunk = Chunk::read($s))
      $this->chunks[] = $chunk;
  }

  function write(IStream $s)
  {
  /*$s->write(
      $this->headers,
      $this->chunks
    );*/
             
    $this->headers ->write($s);
    foreach ($this->chunks as $chunk)
      $chunk->write($s);
    $s->write((string)0, "\r\n");
  }
}

class Requests //implements IStream_Struct
{
  var $list  =[];

  function read(IStream $s)
  {
  //$s->repeatUntilEnd(Request::class);?
    while ($s->waitMore())
    {
      $item = new Request();
      $item->read($s);
      $this->list[] = $item;
    }
  }

  function write(IStream $s)
  {
  //$s->write($this->list);
    foreach ($this->list as $item)
      $item->write($s);
  }
}

Loop::async
(function(){
  $example = <<<HereDoc
    Request1.FirstLine
    Header.Key1: Header.Value1
    Header.Key2: Header.Value2
    Header.Key3: Header.Value3
  
    3
    Chunk1.Line1
    Chunk1.Line2
    Chunk1.Line3
    2
    Chunk2.Line1
    Chunk2.Line2
    0
    Request2.FirstLine
    Header.Key1: Header.Value1
    Header.Key2: Header.Value2
  
    2
    Chunk1.Line1
    Chunk1.Line2
    3
    Chunk2.Line1
    Chunk2.Line2
    Chunk2.Line3
    0
    
    HereDoc;
  
  $example = str_replace("\n", "\r\n", $example);
  
  $istream = new Stream_Async_Mock()->syncStream();
  $ostream = new Stream_Async_Mock()->syncStream();
  
  Loop::async(function() use($istream, $example){
    $istream->write($example);
    $istream->writeEnd();
  });
  Loop::async(function() use($ostream, $example){
    $result = $ostream->until()->end()->read();
    
    if ($result === $example) return Logger::log('Ok');
    
    $result  = str_replace("\r\n", "\n", $result  );
    $example = str_replace("\r\n", "\n", $example );
    
    Logger::error('Failed:')->Dump([$result, $example]);//($result);
  });
  
  $requests = new Requests();
/*$istream->read  ($requests);
  $ostream->write ($requests);*/
  $requests->read  ($istream);
  $requests->write ($ostream);  
  $ostream->writeEnd();
});
