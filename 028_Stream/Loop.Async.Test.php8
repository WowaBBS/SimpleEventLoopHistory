<?
include '_All.Cli.php';

// 1. Запускаем первый асинхронный процесс
Loop::async(function() {
  Logger::log('[Process 1] Starting. Have a HTTP-request to API...');
  
  // Магия Fibers: await() ставит этот файбер на паузу, 
  // пока Loop качает данные из сокета
//$html = httpGetAsync('http://wowa.su')->await();
  $html = httpGetAsync('http://127.0.0.1')->await();
  
  Logger::log('[Process 1] Sucess! Received chars: ', strlen($html));
});

// 2. Параллельно запускаем второй процесс
Loop::async(function() {
  Logger::log('[Process 2] I\'m working too! Sleep for 1.5s...');
  
  // Спим без блокирования всего PHP-скрипта
  sleepAsync(1.5)->await();
  
  Logger::log('[Process 2] Awake in 1.5s!');
});

// 3. Запускаем бесконечный цикл событий, который крутит все эти процессы
Logger::log('--- Start Event Loop ---');
Loop::run();
Logger::log('--- Event Loop finished ---');
