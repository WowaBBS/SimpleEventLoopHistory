<?
include '../../_All.Test.php';

Loop::async(function() {
  Logger::log('[Case 1] Do long reqest with timeout 1.5 sec...');

  // Имитируем запрос, который длится 3 секунды
  $requestPromise = sleepAsync(3.0)->then(fn() => "Data from server");

  // Создаем промис-таймаут, который упадет через 1.5 секунды
  $timeoutPromise = sleepAsync(1.5)->then(function() {
    throw new \RuntimeException("Time request is out!");
  });

  try
  {
    // Запускаем гонку!
    $result = Promise::race([$requestPromise, $timeoutPromise])->await();
    Logger::log('Sucess: ', $result);
  }
  catch (\Throwable $e)
  {
    // Сработает таймаут, так как 1.5с < 3.0с
    Logger::error('Error race: ', $e->getMessage()); 
  }
});

Loop::run();