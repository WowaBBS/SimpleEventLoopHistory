<?
include '../_All.Cli.php';

// 1. Создадим тестовый относительно "большой" файл (для примера)
$largeFileName=LargeFile();

// 2. Процесс 1: Быстрый таймер, который должен тикать без задержек
Loop::async(function() {
  for ($i = 1; $i <= 5; $i++)
  {
    Logger::log('[Timer] tick', $i);
    sleepAsync(0.1)->await(); // спим 100мс
  }
});

// 3. Процесс 2: Асинхронное чтение файла
Loop::async(function() {
  Logger::log('[File] Starting async file reading...');
  
  $startTime = microtime(true);
  
  global $largeFileName;
  
  // Вызываем нашу обертку. Код замирает, но Event Loop продолжает крутиться!
  $content = FileReaderChunk::readAll($largeFileName, 16384)->await(); 
  
  $endTime = microtime(true);
  $duration = round(($endTime - $startTime) * 1000, 2);
  
  Logger::log('[File] Sucessfuly read ', strlen($content), ' bytes for {', $duration, '} ms!');
});

Logger::log('--- Start Event Loop ---');
Loop::run();
Logger::log('--- Loop is complete ---');
