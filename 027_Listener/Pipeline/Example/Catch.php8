<?
include '../../_All.Test.php';
include 'Data.php';

Loop::setTimeLimit(15, 5);

function emitData($promise, $type, $value)
{
  switch($type)
  {
  case  0: $promise->resolve($value); break;
  case  1: $promise->reject($value); break;
  case  2: $promise->abort($value); break;
  default:
  //$promise->abort('Unknown type='.$type);
    $promise->resolve($value);
  }
}

function asyncData($delayed, $type, $value='data')
{
  $promise=New Deferred()->Promise();

  if($delayed)
    Loop::delay($delayed, fn()=>emitData($promise, $type, $value));
  else
    emitData($promise, $type, $value);
  
  return $promise;
}

function readInt(int &$stream, int $count)
{
  $result =        $stream % $count;
  $stream = IntDiv($stream , $count);
  return $result;
}

